image_name := "ghcr.io/wrossmorrow/envoy-extproc-sdk-site-cntrl"
image_tag := `git rev-parse --short HEAD`

default:
    just --list

# update dependendencies
update:
    go get -u && just tidy

# cleanup modules
tidy:
    go mod tidy

# format code
format:
    go fmt ./...

# run linter
lint:
    golangci-lint run ./...

# run vetter
vet:
    go vet -vettool=$(go env GOPATH)/bin/shadow ./...

# run unit tests
unit-test: 
    go test -v ./...

# run unit tests
test:
    go test ./...

# run a specific example
run:
    go run ./...

# codegen, in agent container for version matching
gen:
    docker run --rm -v "$PWD":/work -w /work --entrypoint buf \
        ghcr.io/wrossmorrow/flint-pi-golang generate

# build binary (variadic flags supported)
build *flags="":
    go build {{flags}} .

containerize tag=image_tag *flags="":
    docker build -t {{image_name}}:{{tag}} . {{flags}}/...
