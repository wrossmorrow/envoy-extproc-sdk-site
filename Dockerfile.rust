ARG RUST_VERSION=1.90
ARG GRPC_HEALTH_PROBE_VERSION=v0.4.39
FROM rust:${RUST_VERSION} AS builder

WORKDIR /build
COPY rust/demo-extproc/Cargo.toml rust/demo-extproc/Cargo.toml
COPY rust/demo-extproc/Cargo.lock rust/demo-extproc/Cargo.lock
COPY rust/demo-extproc/src/ rust/demo-extproc/src/
COPY gen/rust/ /build/gen/rust/
WORKDIR /build/rust/demo-extproc
RUN cargo build --release

FROM rust:${RUST_VERSION}
COPY --from=builder /build/rust/demo-extproc/target/release/demo-extproc /app/demo-extproc
ARG GRPC_HEALTH_PROBE_VERSION
ARG TARGETARCH
RUN curl -fsSL "https://github.com/grpc-ecosystem/grpc-health-probe/releases/download/${GRPC_HEALTH_PROBE_VERSION}/grpc_health_probe_linux-${TARGETARCH}" \
    -o /bin/grpc-health-probe && \
    chmod +x /bin/grpc-health-probe
ENTRYPOINT ["/app/demo-extproc"]
